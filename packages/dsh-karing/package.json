{
  "name": "@local/dsh-karing",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone Karing control plugin for DeepSeek Harness: drive karingService.exe without the GUI, switch split-tunnel modes (rule/proxy/direct) by pointing the system proxy at one of Karing's three mixed inbounds, pick nodes through the Clash API, and search/fetch through the proxy.",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/core.js": {
      "default": "./lib/core.js"
    },
    "./lib/net.js": {
      "default": "./lib/net.js"
    },
    "./lib/proxy.js": {
      "default": "./lib/proxy.js"
    },
    "./lib/search.js": {
      "default": "./lib/search.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "karing",
    "sing-box",
    "proxy",
    "split-tunnel",
    "lan"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cjrrrrrrrr/dsh-plugins.git",
    "directory": "packages/dsh-karing"
  },
  "homepage": "https://github.com/Cjrrrrrrrr/dsh-plugins/tree/main/packages/dsh-karing#readme",
  "bugs": {
    "url": "https://github.com/Cjrrrrrrrr/dsh-plugins/issues"
  },
  "files": [
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md"
  ]
}
